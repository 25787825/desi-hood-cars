{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/.netlify/functions/auto-news", "destination": "/api/auto-news" },
    { "source": "/.netlify/functions/new-cars", "destination": "/api/new-cars" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
